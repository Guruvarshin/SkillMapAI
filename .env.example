# SkillMap AI — Environment Variables Template
# Copy this file to .env and fill in your real keys
# NEVER commit .env to GitHub

# Anthropic — Claude Sonnet 4.5 + Haiku 4.5
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model overrides (OPTIONAL — only set if you get 404 model not found errors)
# Default Haiku:  claude-haiku-4-5  (Claude 4 family, fast + cheap)
# Default Sonnet: claude-sonnet-4-5 (Claude 4 family, reasoning)
# Fallback Haiku if 4.5 not on your tier: claude-3-5-haiku-20241022
# HAIKU_MODEL=anthropic/claude-3-5-haiku-20241022
# SONNET_MODEL=anthropic/claude-3-5-sonnet-20241022

# YouTube Data API v3
# Get from: https://console.cloud.google.com/ → Enable "YouTube Data API v3"
YOUTUBE_API_KEY=your_youtube_api_key_here

# Tavily Search API
# Get from: https://tavily.com/ (1,000 free searches/month)
TAVILY_API_KEY=your_tavily_api_key_here

# MongoDB Atlas Connection String
# Get from: https://cloud.mongodb.com/ → Connect → Drivers
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/skillmap?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_uri_here

# Disable CrewAI's interactive tracing prompt (important for Streamlit)
CREWAI_TRACING_ENABLED=false

# Groq API Key (OPTIONAL — free tier, used for mechanical agents)
# If set: video_hunter, course_curator, quiz_generator, timeline_budget,
#         assembler all use Groq llama-3.3-70b (free) instead of Haiku
# If not set: falls back to Anthropic Haiku 3.5 automatically
# Get from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
